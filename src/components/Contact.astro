---
const encodedEmail = btoa('theodore.falkiner@gmail.com');
---

<section id="contact" class="relative section-padding overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-dark via-dark-light to-primary/30"></div>

  <!-- Decorative shapes -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent/10 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <span class="inline-block px-4 py-1.5 bg-white/10 text-white/70 rounded-full text-sm font-semibold mb-6 tracking-wide uppercase">Get in Touch</span>
    <h2 class="text-4xl md:text-6xl font-black text-white mb-6">
      Let's make something together
    </h2>
    <p class="text-white/60 text-lg md:text-xl max-w-2xl mx-auto mb-10">
      Interested in collaborating on a production, sound design, live event, or original theatre project?
      Get in touch.
    </p>

    <!-- Contact links -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a
        id="email-contact"
        href="#contact"
        data-email={encodedEmail}
        aria-disabled="true"
        tabindex="-1"
        class="btn-primary flex items-center gap-3 text-lg cursor-pointer aria-disabled:cursor-not-allowed aria-disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Send an Email
      </a>
    </div>
    <noscript><p class="text-white/60">Email contact requires JavaScript.</p></noscript>
  </div>
</section>

<script>
  const emailLink = document.querySelector<HTMLAnchorElement>('#email-contact');

  if (emailLink) {
    emailLink.addEventListener('click', (event) => {
      const encodedAddress = emailLink.dataset.email;
      if (!encodedAddress) {
        event.preventDefault();
        return;
      }

      emailLink.href = `mailto:${atob(encodedAddress)}`;
      setTimeout(() => emailLink.setAttribute('href', '#contact'), 0);
    });
    emailLink.removeAttribute('aria-disabled');
    emailLink.removeAttribute('tabindex');
  }
</script>
