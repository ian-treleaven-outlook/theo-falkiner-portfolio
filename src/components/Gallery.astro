const baseUrl = import.meta.env.BASE_URL;
const assetBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const imageUrl = (folder: string, file: string) => `${assetBaseUrl}images/productions/${folder}/${file}`;
---

<section id="portfolio" class="section-padding bg-light overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 bg-secondary/10 text-secondary rounded-full text-sm font-semibold mb-6 tracking-wide uppercase">Productions</span>
      <h2 class="text-4xl md:text-5xl font-black text-dark mb-4">
        Selected <span class="gradient-text">Works</span>
      </h2>
      <p class="text-dark/50 text-lg max-w-2xl mx-auto">
        Theatre productions Theo has written, directed, produced, or performed in.
      </p>
    </div>

    <div class="space-y-12">
      {productions.map((production) => (
        <article class="production-card" data-production-card>
          <header class="production-header">
            <div>
              <p class="production-eyebrow">{production.eyebrow}</p>
              <h3>{production.title}</h3>
            </div>
            <div class="production-copy">
              <p class="production-credit">{production.credit}</p>
              {production.description && <p>{production.description}</p>}
              {production.award && <p class="production-award">{production.award}</p>}
            </div>
          </header>

          <div class="gallery-toolbar">
            <span class="gallery-status" data-gallery-status aria-live="polite">1 / {production.images.length}</span>
            <div class="gallery-controls">
              <button type="button" data-gallery-previous aria-label={`Previous image in ${production.title}`} disabled>
                <span aria-hidden="true">&larr;</span>
              </button>
              <button type="button" data-gallery-next aria-label={`Next image in ${production.title}`}>
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          </div>

          <div class="production-gallery" data-gallery tabindex="0" role="region" aria-label={`${production.title} image gallery`}>
            {production.images.map((image, imageIndex) => (
              <figure class:list={["production-slide", { "poster-slide": imageIndex === 0 }]} data-gallery-slide>
                <img
                  src={imageUrl(production.folder, image.file)}
                  alt={image.alt}
                  loading={imageIndex === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-production-card]").forEach((card) => {
    const gallery = card.querySelector<HTMLElement>("[data-gallery]");
    const slides = Array.from(card.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const previousButton = card.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const nextButton = card.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const status = card.querySelector<HTMLElement>("[data-gallery-status]");

    if (!gallery || !previousButton || !nextButton || !status) return;

    let currentIndex = 0;
    let animationFrame = 0;

    const updateControls = () => {
      const galleryStart = gallery.scrollLeft + gallery.clientLeft;
      currentIndex = slides.reduce((closestIndex, slide, index) => {
        const currentDistance = Math.abs(slides[closestIndex].offsetLeft - galleryStart);
        const nextDistance = Math.abs(slide.offsetLeft - galleryStart);
        return nextDistance < currentDistance ? index : closestIndex;
      }, 0);

      previousButton.disabled = currentIndex === 0;
      nextButton.disabled = currentIndex === slides.length - 1;
      status.textContent = `${currentIndex + 1} / ${slides.length}`;
    };

    const goToSlide = (index: number) => {
      const targetIndex = Math.max(0, Math.min(index, slides.length - 1));
      gallery.scrollTo({ left: slides[targetIndex].offsetLeft - gallery.clientLeft, behavior: "smooth" });
    };

    previousButton.addEventListener("click", () => goToSlide(currentIndex - 1));
    nextButton.addEventListener("click", () => goToSlide(currentIndex + 1));
    gallery.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        goToSlide(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    gallery.addEventListener("scroll", () => {
      cancelAnimationFrame(animationFrame);
      animationFrame = requestAnimationFrame(updateControls);
    }, { passive: true });
    window.addEventListener("resize", updateControls, { passive: true });
  });
</script>

<style>
  .production-card {
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 10%);
    border-radius: 0.5rem;
    background: white;
    box-shadow: 0 18px 50px rgb(15 23 42 / 8%);
  }

  .production-header {
    display: grid;
    gap: 1.25rem;
    padding: 2rem 1.5rem 1.5rem;
  }

  .production-eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .production-header h3 {
    max-width: 18ch;
    color: var(--color-dark);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.05;
  }

  .production-copy {
    max-width: 42rem;
    color: rgb(15 23 42 / 62%);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .production-credit {
    color: var(--color-dark);
    font-weight: 700;
  }

  .production-award {
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .production-copy p + p {
    margin-top: 0.65rem;
  }

  .gallery-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem 0.75rem;
  }

  .gallery-status {
    color: rgb(15 23 42 / 52%);
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .gallery-controls {
    display: flex;
    gap: 0.5rem;
  }

  .gallery-controls button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid rgb(15 23 42 / 18%);
    border-radius: 50%;
    color: var(--color-dark);
    font-size: 1.15rem;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .gallery-controls button:hover:not(:disabled),
  .gallery-controls button:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: white;
    outline: none;
  }

  .gallery-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.3;
  }

  .production-gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding: 0 1.5rem 1.5rem;
    scroll-behavior: smooth;
    scroll-padding-inline: 1.5rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: rgb(99 102 241 / 55%) rgb(15 23 42 / 8%);
    scrollbar-width: thin;
  }

  .production-gallery:focus-visible {
    outline: 3px solid rgb(99 102 241 / 35%);
    outline-offset: -3px;
  }

  .production-slide {
    position: relative;
    flex: 0 0 min(82vw, 48rem);
    height: clamp(20rem, 52vw, 38rem);
    overflow: hidden;
    border-radius: 0.375rem;
    background: #e8e8ec;
    scroll-snap-align: start;
  }

  .production-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .production-slide.poster-slide {
    flex-basis: min(76vw, 28rem);
    background: #dcdce2;
  }

  .poster-slide img {
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .production-header {
      grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
      align-items: end;
      padding: 2.5rem 2.5rem 2rem;
    }

    .gallery-toolbar {
      padding-inline: 2.5rem;
    }

    .production-gallery {
      gap: 1.25rem;
      padding: 0 2.5rem 2.5rem;
      scroll-padding-inline: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .production-gallery {
      scroll-behavior: auto;
    }
  }
</style>
